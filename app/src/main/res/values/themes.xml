<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SaltReplica" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_bg</item>
        <item name="colorOnBackground">@color/on_bg</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 三套深色主题：底色沿用夜间色板，只换强调色（参考图配色） -->
    <style name="Theme.SaltReplica.Neon" parent="Theme.SaltReplica">
        <item name="colorPrimary">#FFB478FF</item>
        <item name="colorOnPrimary">#FF170F22</item>
        <item name="colorPrimaryContainer">#FF3B2452</item>
        <item name="colorSecondary">#FF74E3CF</item>
    </style>

    <style name="Theme.SaltReplica.Ember" parent="Theme.SaltReplica">
        <item name="colorPrimary">#FFFF8A5C</item>
        <item name="colorOnPrimary">#FF241207</item>
        <item name="colorPrimaryContainer">#FF4A2617</item>
        <item name="colorSecondary">#FFFFC46B</item>
    </style>

    <style name="Theme.SaltReplica.Lemon" parent="Theme.SaltReplica">
        <item name="colorPrimary">#FFDCEF5A</item>
        <item name="colorOnPrimary">#FF1B1E07</item>
        <item name="colorPrimaryContainer">#FF3A3F16</item>
        <item name="colorSecondary">#FF9FE870</item>
    </style>

    <style name="TextTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/on_bg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/on_bg_sub</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/on_bg</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- 列表封面圆角 -->
    <style name="ShapeCover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- 播放页大封面圆角 -->
    <style name="ShapeCoverLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="TextSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/on_bg_sub</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- 自绘弹框主题：去掉系统白底与标题栏，卡片完全由 dialog_app.xml 决定 -->
    <style name="AppDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.34</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
</resources>
