<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/queue_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="播放列表"
        android:textColor="@color/on_bg"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/queue_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="长按任意一首可拖动调整播放顺序"
        android:textColor="@color/on_bg_sub"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/queue_empty"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:gravity="center"
        android:text="播放列表是空的，先去音乐库选一首歌"
        android:textColor="@color/on_bg_sub"
        android:textSize="12sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/queue_recycler"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none" />
</LinearLayout>
